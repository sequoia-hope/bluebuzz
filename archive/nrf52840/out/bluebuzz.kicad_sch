	(text "32.768 kHz LFXO" (at 740.22 204.47 0)
		(effects (font (size 1.6 1.6) (bold yes)) (justify left bottom))
		(uuid "c4bae6e0-ac96-583f-84d1-edaf529352b4"))
	(text "43 pads: 28 castellated plus 15 bottom-only interior pads, so this board needs a stencil. Every GPIO used here is on an EDGE pad; only GND (24) is" (at 790.58 307.68 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "d452d1ff-ccf2-5fb6-92b5-405d49277bea"))
	(text "interior. The ceramic antenna is at the pad-free end of the body: that end sits at the board edge with no copper under it on any layer. Pad 26 is" (at 790.58 310.34 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "bc955131-74f6-5714-b56d-4e7f63224fcc"))
	(text "P0.18, the only pin the nRF52840 can use as nRESET. Y1 is Nordic's reference LFXO: a 3215 9 pF-CL part with 12 pF NP0 loads." (at 790.58 313.0 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "e03bf73f-07be-5817-9362-f4d35b50ab0c"))
	(polyline (pts (xy 734.9 135.18) (xy 942.748 135.18) (xy 942.748 318.0) (xy 734.9 318.0) (xy 734.9 135.18))
		(stroke (width 0.1524) (type dash))
		(uuid "a2ae7bac-f929-53f3-a7ed-f2338ff27515"))
	(text "Block 8 — nRF52840 module (E73-2G4M08S1C, onboard antenna)" (at 736.17 133.58 0)
