	(global_label "LED_STAT" (shape input) (at 248.92 488.95 0)
		(effects (font (size 1.27 1.27)) (justify right))
		(uuid "0d7ba83e-8e07-5fa6-b954-6a00cc5ef838"))
	(text "Press SW1: VSYS reaches the LDO's EN through D5 and 3V3 comes up; the" (at 204.98 516.89 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "d4ca52ae-abd2-5ba1-9555-762ec65eb150"))
	(text "RP2350 boots and drives PWR_HOLD (GPIO19) high, so the board stays on" (at 204.98 519.55 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "a760b7a9-a85f-5c33-9e50-39ce6c690ca6"))
	(text "after release. Firmware reads the button on GPIO8 (Q3, active low," (at 204.98 522.21 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "736b70f6-f286-51d7-9c2b-0f5966d96354"))
	(text "internal pull-up) and switches off by driving PWR_HOLD low. R63 holds" (at 204.98 524.87 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "391e6f6f-4c27-506c-9ef5-8f0965e73f61"))
	(text "EN off; R64 discharges the gate. USB in (VBUS through D6 and R66) also" (at 204.98 527.53 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "d93ccf3a-b435-5f5d-9d21-2fbb16aedcce"))
	(text "holds EN on, so flashing and SWD need no button. Charging runs while" (at 204.98 530.19 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "f7879790-66a7-525f-9dd7-0b3fa22cc708"))
	(text "off. Status: a 1010 addressable RGB LED (WS2812B type) on GPIO22" (at 204.98 532.85 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "bbf6e3d0-d47b-5975-856e-1b91b07c2c92"))
	(text "through 330 R; its VSYS supply goes through U11 (a second TPS22918, ON" (at 204.98 535.51 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "4010e404-8a5f-5dee-8199-8e051cc79989"))
	(text "= 3V3_SYS), so it draws nothing while the system is off." (at 204.98 538.17 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "061e1005-587d-5215-be8e-9a24299ce791"))
	(polyline (pts (xy 199.98 361.24) (xy 310.18 361.24) (xy 310.18 543.17) (xy 199.98 543.17) (xy 199.98 361.24))
		(stroke (width 0.1524) (type dash))
		(uuid "dc8ed114-4982-5440-bcb8-a1c40daaddcc"))
	(text "7 — power button (soft latch) and status LED" (at 201.25 359.64 0)
		(effects (font (size 2.2 2.2) (bold yes)) (justify left bottom))
		(uuid "f9e819f6-2381-534c-a2ed-494f22fe2014"))
