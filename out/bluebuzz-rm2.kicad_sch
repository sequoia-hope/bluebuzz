	(text "bluebuzz-rm2 — generated schematic" (at 16 15 0)
		(effects (font (size 4.0 4.0) (bold yes)) (justify left bottom))
		(uuid "86ff2c63-d82a-5f77-be94-7a9c1cbf5fcd"))
	(text "109 components / 72 nets / 6-layer.  Bluetooth-audio vibrator controller: RP2350A + Raspberry Pi RM2 (CYW43439); USB-C, every other lead on back-side pads; BQ24074 charger with power path, a soft power latch (button, GPIO hold, USB), two low-side motor channels, 4 DPS368 barometers on the back (four corners and the centre, a tactile skin) on a switched 3.3 V rail, an IMU and a 1010 RGB status LED.  Rails are power symbols; cross-block signals are global labels.  Generated from scripts/circuit.py; rebuild with `python3 build.py --only schematic`." (at 16 21 0)
		(effects (font (size 1.8 1.8)) (justify left bottom))
		(uuid "43d663d9-0017-5d7c-9ccd-696c3f5e77d0"))
	(symbol (lib_id "gen:usb_conn")
